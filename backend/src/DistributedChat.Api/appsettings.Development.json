{
  "Application": {
    "Name": "DistributedChat (Development)"
  },
  "ConnectionStrings": {
    "DistributedChat": "Host=localhost;Port=5432;Database=distributed_chat;Username=distributed_chat;Password=distributed_chat_local_password"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "ManagementPort": 15672,
    "UserName": "distributed_chat",
    "Password": "distributed_chat_local_password",
    "VirtualHost": "distributed_chat",
    "ExchangeName": "chat.events",
    "PrefetchCount": 10
  },
  "Instance": {
    "InstanceId": "local"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "Jwt": {
    "Issuer": "DistributedChat",
    "Audience": "DistributedChat.Api",
    "SigningKey": "distributed-chat-local-demo-signing-key-change-me-32-plus-chars",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DistributedChat": "Debug"
    }
  }
}
