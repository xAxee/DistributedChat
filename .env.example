# Copy this file to .env for local Docker Compose runs.
# Review all values before use. The three secret values are required by Compose.

NGINX_HTTP_PORT=80
CHAT_SERVICE_1_PORT=5080
CHAT_SERVICE_2_PORT=5082

POSTGRES_DB=distributed_chat
POSTGRES_USER=distributed_chat
POSTGRES_PASSWORD=distributed_chat_local_password
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=distributed_chat
RABBITMQ_DEFAULT_PASS=distributed_chat_local_password
RABBITMQ_DEFAULT_VHOST=distributed_chat
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE_NAME=chat.events
RABBITMQ_PREFETCH_COUNT=10

# JWT demo values for local development only. Use a strong secret from a secure secret store elsewhere.
JWT_ISSUER=DistributedChat
JWT_AUDIENCE=DistributedChat.Api
JWT_SIGNING_KEY=distributed-chat-local-demo-signing-key-change-me-32-plus-chars
JWT_EXPIRATION_MINUTES=60
